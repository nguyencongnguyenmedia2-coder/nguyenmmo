# =========================================================================
# ☁️ CLOUDFLARE R2 OBJECT STORAGE CONFIGURATION
# =========================================================================
# 1. Cloudflare Account ID: Lấy tại Dashboard Cloudflare -> Account ID
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id_here"

# 2. Cloudflare R2 API Tokens: Lấy tại R2 -> Manage R2 API Tokens (Quyền Admin Read/Write)
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"

# 3. Tên R2 Bucket đã tạo trên Cloudflare (VD: nguyenmmo-blog-images)
CLOUDFLARE_R2_BUCKET_NAME="nguyenmmo-blog-images"

# 4. Tùy chọn Tên miền công khai:
# - URL mặc định r2.dev (VD: https://pub-123456789.r2.dev)
# - Hoặc Custom Domain riêng (VD: https://cdn.nguyenmmo.com)
CLOUDFLARE_R2_PUBLIC_URL="https://cdn.nguyenmmo.com"

# =========================================================================
# 🔑 SERVER AUTHENTICATION SESSION KEY
# =========================================================================
SESSION_SECRET="nguyenmmo_secret_session_key_2026"
